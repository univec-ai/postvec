# Produced by the scripts from a commit plus versions.env. Do not commit it.
build/
dist/

# The repository root ignores *.txt. These two are release contracts:
# the hash-locked schema-validator set and the reviewed lintian tags.
# A missing negation shows up in CI, where the file is simply absent.
!requirements-schema.txt
!lintian-exceptions.txt

# The flat release staging directory, assembled by write-release-manifest.sh.
release/

# Python bytecode from the helper scripts.
__pycache__/
