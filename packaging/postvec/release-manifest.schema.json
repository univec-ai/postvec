{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/univec-ai/postvec/packaging/postvec/release-manifest.schema.json",
  "title": "postvec release manifest",
  "description": "The machine-readable index of one postvec release: what was built, from which source, with which pinned inputs, and what each artifact hashes to. Generated by scripts/write-release-manifest.sh from the artifacts themselves \u2014 never hand-edited.",
  "type": "object",
  "required": [
    "schema",
    "postvec_version",
    "package_release",
    "git_commit",
    "source_date_epoch",
    "rust",
    "cargo_pgrx",
    "pgvector_min",
    "onnxruntime",
    "extension_features",
    "licenses",
    "postgresql_majors",
    "architectures",
    "bundled_model",
    "artifacts",
    "release_assets",
    "images",
    "release_id",
    "inputs",
    "build_cells"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": 1
    },
    "postvec_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "package_release": {
      "type": "string"
    },
    "git_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "git_tag": {
      "type": "string"
    },
    "built_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_date_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "rust": {
      "type": "string"
    },
    "cargo_pgrx": {
      "type": "string"
    },
    "pgvector_min": {
      "type": "string"
    },
    "onnxruntime": {
      "type": "string"
    },
    "extension_features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Cargo features the published library was compiled with, beyond the pgNN selector. 'embedded' must be present: every public package is the embedded-capable build."
    },
    "licenses": {
      "type": "object",
      "description": "The licence each artifact family carries. Everything is under `default` (the PostgreSQL License) except the postvec-server package and image, whose identifier is the reviewed SERVER_LICENSE pin.",
      "required": [
        "default",
        "postvec-server"
      ],
      "additionalProperties": false,
      "properties": {
        "default": {
          "const": "PostgreSQL"
        },
        "postvec-server": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9.+-]*$"
        }
      }
    },
    "postgresql_majors": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 13
      }
    },
    "architectures": {
      "type": "array",
      "items": {
        "enum": [
          "amd64",
          "arm64"
        ]
      }
    },
    "bundled_model": {
      "type": "object",
      "description": "The model the release bundles, as the postvec model registry describes it. The archive digest is the pin the build refuses to deviate from; the revision is the head it was cut against.",
      "required": [
        "name",
        "backend",
        "channel",
        "registry_revision",
        "archive_sha256",
        "archive_size",
        "source",
        "license",
        "target_dim",
        "sequence_len",
        "bundle_version",
        "package"
      ],
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string",
          "description": "The name postvec.models and every registry row store. Vectors are only comparable within one name; changing weights, tokenizer, pooling, normalisation or sequence length behind it is forbidden."
        },
        "backend": {
          "type": "string"
        },
        "channel": {
          "type": "string",
          "description": "The registry channel the archive was taken from. A packaged model is always public: a private model inside a public package would be a redistribution decision made by accident.",
          "enum": [
            "public"
          ]
        },
        "registry_revision": {
          "type": "integer",
          "minimum": 1
        },
        "archive_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "archive_size": {
          "type": "integer",
          "minimum": 1
        },
        "source": {
          "type": "string",
          "description": "The registry's free-form upstream provenance, recorded verbatim. Read from the payload's SOURCE.json rather than from a shell variable."
        },
        "license": {
          "type": "string"
        },
        "target_dim": {
          "type": "integer",
          "minimum": 1
        },
        "sequence_len": {
          "type": "integer",
          "minimum": 1
        },
        "bundle_version": {
          "type": "integer",
          "minimum": 1
        },
        "package": {
          "type": "string",
          "description": "The binary package that carries it: postvec-model-<reviewed suffix>."
        },
        "files_sha256": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "sha256",
          "size",
          "platform",
          "arch",
          "format"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 1
          },
          "platform": {
            "type": "string"
          },
          "arch": {
            "type": "string"
          },
          "format": {
            "enum": [
              "deb",
              "rpm"
            ]
          },
          "package": {
            "type": "string"
          },
          "pg_major": {
            "type": [
              "integer",
              "null"
            ]
          },
          "sbom": {
            "type": "string"
          },
          "sbom_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "release_assets": {
      "type": "array",
      "description": "Published files that are not packages. Today that is the prerequisite bootstrap, which is the one asset a user is instructed to execute — so it is described here, checksummed in SHA256SUMS, and attested in its own right rather than only through the checksum file.",
      "items": {
        "type": "object",
        "required": [
          "name",
          "sha256",
          "size",
          "role"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 1
          },
          "role": {
            "enum": [
              "prerequisites"
            ]
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "tag",
          "digest",
          "variant",
          "pg_major",
          "base_digest",
          "platforms"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "tag": {
            "type": "string"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$",
            "description": "Digest of the multi-architecture index a tag resolves to. Build provenance is attested against this."
          },
          "variant": {
            "enum": [
              "remote",
              "complete",
              "server"
            ],
            "description": "`remote` and `complete` are the PostgreSQL images, one per major. `server` is the postvec-server inference node: its own repository, no PostgreSQL major (pg_major is null), tagged with the bare release id and built on the pinned Debian 12 base."
          },
          "pg_major": {
            "type": [
              "integer",
              "null"
            ]
          },
          "base_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "platforms": {
            "type": "array",
            "minItems": 1,
            "description": "The child manifests of the index, one per architecture, each with its own SBOM. An SPDX document produced against the index digest describes only whichever child the scanner defaulted to — linux/amd64 — so one document per index would be a claim about arm64 that nothing checked.",
            "items": {
              "type": "object",
              "required": [
                "platform",
                "digest",
                "sbom",
                "sbom_sha256"
              ],
              "additionalProperties": false,
              "properties": {
                "platform": {
                  "enum": [
                    "linux/amd64",
                    "linux/arm64"
                  ]
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$",
                  "description": "Digest of this architecture's child manifest. Its SBOM is attested against this digest, not against the index."
                },
                "sbom": {
                  "type": "string",
                  "description": "File name of the SPDX document describing this child image, published alongside it."
                },
                "sbom_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        }
      }
    },
    "release_id": {
      "type": "string",
      "description": "POSTVEC_VERSION-PACKAGE_RELEASE: the identity a release tag and its image tags carry."
    },
    "inputs": {
      "type": "object",
      "description": "Every pinned build input, so a reader need not fetch the commit's versions.env to know what produced this release.",
      "additionalProperties": true,
      "required": [
        "rust",
        "cargo_pgrx",
        "rustup",
        "protoc",
        "nfpm",
        "onnxruntime",
        "pgdg",
        "base_images",
        "sbom",
        "buildx"
      ]
    },
    "build_cells": {
      "type": "array",
      "description": "What each builder actually resolved \u2014 PostgreSQL version, compiler, glibc, and its full installed-package inventory. PGDG publishes no snapshots, so this is the only durable record of what an artifact was built against.",
      "items": {
        "type": "object",
        "required": [
          "cell",
          "distro",
          "pg_major",
          "arch",
          "base",
          "pg_version",
          "rustc",
          "cargo_pgrx",
          "glibc",
          "packages",
          "packages_sha256"
        ],
        "additionalProperties": true,
        "properties": {
          "cell": {
            "type": "string"
          },
          "distro": {
            "type": "string"
          },
          "pg_major": {
            "type": "integer"
          },
          "arch": {
            "enum": [
              "amd64",
              "arm64"
            ]
          },
          "pg_version": {
            "type": "string"
          },
          "rustc": {
            "type": "string"
          },
          "cargo_pgrx": {
            "type": "string"
          },
          "glibc": {
            "type": "string"
          },
          "base": {
            "type": "string"
          },
          "packages": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Every package installed in the builder, so a mutable repository does not make the cell unauditable."
          },
          "packages_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
