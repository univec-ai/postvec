# Every value here is a *pin* - nothing in packaging/postvec/ resolves a version
# by itself. `scripts/assert-versions.sh` refuses to start a release when this
# file still contains a <PLACEHOLDER>, when a digest is malformed, or when
# POSTVEC_VERSION disagrees with the crates and the release tag.
#
# Refreshing a pin: `scripts/refresh-pins.sh` re-downloads the pinned inputs
# and prints the lines to paste here. It never edits this file — a pin change
# is a review event, not an automated one.

# ---------------------------------------------------------------- the product
# Must equal postvec/Cargo.toml, postvec-cli/Cargo.toml and the release tag
# (postvec-v${POSTVEC_VERSION}).
POSTVEC_VERSION=0.3.0
# Packaging-only revision. Bump for a rebuild that changes no source (a
# dependency-metadata fix, a maintainer-script fix); reset to 1 on a version bump.
#
# It is part of the *release identity*, not only of package file names: the git
# tag is postvec-v${POSTVEC_VERSION}-${PACKAGE_RELEASE} and image tags are
# ${POSTVEC_VERSION}-${PACKAGE_RELEASE}-pg<major>. Without that, a 0.1.0-2
# rebuild would silently overwrite a 0.1.0-1-pg18-local image,
# and an immutable tag would not be immutable.
PACKAGE_RELEASE=1

# ------------------------------------------------------------------ toolchain
RUST_VERSION=1.96.0
PGRX_VERSION=0.18.1
# rustup-init is the one binary a builder image downloads. It is pinned by
# archive version *and* per-architecture digest, so the toolchain install is
# verifiable rather than a `curl | sh` of whatever is current today.
RUSTUP_VERSION=1.29.0
RUSTUP_INIT_X86_64_SHA256=4acc9acc76d5079515b46346a485974457b5a79893cfb01112423c89aeb5aa10
RUSTUP_INIT_AARCH64_SHA256=9732d6c5e2a098d3521fca8145d826ae0aaa067ef2385ead08e6feac88fa5792
# postvec's build.rs compiles the vendored proto with tonic-build, so protoc is
# a build input like any other. Distribution packages differ by several major
# versions across the supported targets (EL9 ships 3.14, in a non-default
# repository), which would make the generated code depend on where it was
# built. One pinned compiler for every builder instead.
PROTOC_VERSION=29.3
PROTOC_LINUX_X86_64_SHA256=3e866620c5be27664f3d2fa2d656b5f3e09b5152b42f1bedbf427b333e90021a
PROTOC_LINUX_AARCH64_SHA256=6427349140e01f06e049e707a58709a4f221ae73ab9a0425bc4a00c8d0e1ab32
# Emits both .deb and .rpm from one package description; run from a pinned
# container unless NFPM_BIN points at a host binary.
NFPM_VERSION=2.43.0
# Pinned by digest, not tag: a tag is a pointer somebody else can move, and
# this container writes the bytes users install.
NFPM_IMAGE=ghcr.io/goreleaser/nfpm:v2.43.0@sha256:929e1056ba69bf1da57791e851d210e9d6d4f528fede53a55bd43cf85674450c
# Syft produces the SBOMs attached to every package and image. Refresh
# with scripts/refresh-pins.sh.
SYFT_VERSION=1.44.0
SYFT_LINUX_AMD64_SHA256=0e91737aee2b5baf1d255b959630194a302335d848ff97bb07921eb6205b5f5a
# Buildx and BuildKit build every package and every image, so they are build
# inputs like the compiler — and pinning the *action* does not pin them.
# `docker/setup-buildx-action` installs whatever buildx it decides is current
# when the runner has none, and the container driver pulls `moby/buildkit:…`
# by tag; both are resolved at run time unless they are named here.
BUILDX_VERSION=v0.35.0
BUILDKIT_IMAGE=moby/buildkit:v0.31.2@sha256:2f5adac4ecd194d9f8c10b7b5d7bceb5186853db1b26e5abd3a657af0b7e26ec
# actionlint checks the release workflows themselves: expression syntax, action
# input schemas, context availability, and — with shellcheck present — the shell
# embedded in every `run:` block. Parsing the YAML locally proves only that it
# is YAML.
ACTIONLINT_VERSION=1.7.12
ACTIONLINT_LINUX_AMD64_SHA256=8aca8db96f1b94770f1b0d72b6dddcb1ebb8123cb3712530b08cc387b349a3d8

# --------------------------------------------------------- PostgreSQL archives
# PGDG is the one supply-chain input postvec cannot pin by content: it publishes
# no snapshots, so the *packages* resolve to whatever is current. What can be
# pinned is the trust root, and it is: the builders verify the Debian signing
# key's fingerprint and the EL9 repository RPM's digest before using either.
#
# The resolved PostgreSQL version of each build cell is recorded in the release
# manifest, so an artifact can always be traced to what it was built against.
PGDG_DEBIAN_KEY_FINGERPRINT=B97B0AFCAA1A47F044F244A07FCC7D46ACCC4CF8
PGDG_EL9_REPO_RPM_X86_64_SHA256=416ce4d364e620c660dc6974b7c52ac6628ccb8375418f37d7dc00a50235b13c
PGDG_EL9_REPO_RPM_AARCH64_SHA256=ac07549ce04d89f9d90315e61c74efb2138afdd6239af7ce6e7881694115a995
# The RPM repository's signing key. The *builders* pin the repository RPM by
# digest, because a builder must be reproducible. A user's bootstrap cannot: the
# URL upstream documents is `-latest`, which moves by design, so pinning its
# hash would break the moment PGDG republishes. The key is the durable trust
# root there — scripts/postvec-prerequisites.sh verifies this fingerprint, then
# checks the downloaded repository RPM's signature against it.
PGDG_RPM_KEY_FINGERPRINT=D4BF08AE67A0B4C7A1DBCCD240BCA2B408B40D20
PGDG_RPM_KEY_URL=https://download.postgresql.org/pub/repos/yum/keys/PGDG-RPM-GPG-KEY-RHEL
# And the aarch64 key, which is a different key in a different file — PGDG signs
# the two architectures separately. Both are pinned here because both are copied
# into the user-facing bootstrap, and tests/unit-test.sh asserts the copies match.
PGDG_RPM_KEY_AARCH64_FINGERPRINT=B031F89FC983E98262906B6E177B343BB9738825
PGDG_RPM_KEY_AARCH64_URL=https://download.postgresql.org/pub/repos/yum/keys/PGDG-RPM-GPG-KEY-AARCH64-RHEL

# ------------------------------------------------------- runtime dependencies
# Minimum pgvector the extension packages depend on. Not vendored: it is a
# package dependency resolved from PGDG or the distribution.
PGVECTOR_MIN_VERSION=0.8

# ONNX Runtime — CPU only for this release line. Redistributed by the
# postvec-onnxruntime package under /opt/postvec/libs/onnxruntime.
# Upstream: https://github.com/microsoft/onnxruntime/releases/tag/v1.22.0
ORT_VERSION=1.22.0
ORT_URL_BASE=https://github.com/microsoft/onnxruntime/releases/download/v1.22.0
ORT_LINUX_X64_SHA256=8344d55f93d5bc5021ce342db50f62079daf39aaafb5d311a451846228be49b3
ORT_LINUX_AARCH64_SHA256=bb76395092d150b52c7092dc6b8f2fe4d80f0f3bf0416d2f269193e347e24702

# ----------------------------------------------------------- the bundled model
# Bundled from the registry public channel via `postvec model pull`.
# BUNDLED_MODEL_NAME is a database compatibility id: do not change
# weights tokenizer pooling or sequence length behind it. Publish a new name.
BUNDLED_MODEL_NAME=sentence-transformers-all-minilm-l6-v2
# The registry head this release was cut against, and the archive digest that
# head resolved to. The digest is the pin: the build refuses any other bytes.
# `scripts/refresh-pins.sh model` prints both for the current head.
BUNDLED_MODEL_REGISTRY_REVISION=2
BUNDLED_MODEL_ARCHIVE_SHA256=531cce26ee0981a74132d70dead36f76d6d7b19e50a01affe2e70617abeb7dbf
# The package is postvec-model-<suffix>; an explicit, reviewed choice rather
# than a slug of the model name, because a package name is forever.
BUNDLED_MODEL_PKG_SUFFIX=minilm-l6-v2
# Independent of POSTVEC_VERSION and of the registry revision: bump when the
# *packaging* around unchanged model bytes changes.
BUNDLED_MODEL_BUNDLE_VERSION=1

# ------------------------------------------------------------- base images
# Multi-arch index digests, resolved once and reviewed. The image build and the
# builder containers pin these; a tag alone is not a pin.
POSTGRES_IMAGE_PG16_DIGEST=sha256:92620daddcd947f8d5ab5ba66e848702fe443d87fed30c4cea8e389fd78dfc55
POSTGRES_IMAGE_PG17_DIGEST=sha256:4f736ae292687621d4dbe0d499ffd024a36bd2ee7d8ca6f2ccd4c800f047b394
POSTGRES_IMAGE_PG18_DIGEST=sha256:1961f96e6029a02c3812d7cb329a3b03a3ac2bb067058dec17b0f5596aca9296

BUILD_BASE_DEBIAN12_DIGEST=sha256:7b140f374b289a7c2befc338f42ebe6441b7ea838a042bbd5acbfca6ec875818
BUILD_BASE_UBUNTU2204_DIGEST=sha256:0e0a0fc6d18feda9db1590da249ac93e8d5abfea8f4c3c0c849ce512b5ef8982
BUILD_BASE_UBUNTU2404_DIGEST=sha256:4fbb8e6a8395de5a7550b33509421a2bafbc0aab6c06ba2cef9ebffbc7092d90
BUILD_BASE_EL9_DIGEST=sha256:d2515c769e7b73f95c4fde38c0a505336ff38f14990c0b7253b77060a049a743

# Add-on metapackage: pins ONNX Runtime + the bundled model. Not a complete
# install - it does not pull the CLI or the extension. Must not contain
# `embedded`, `engine`, `complete`, `local` or `remote` (a mode, a rejected
# name and the two PostgreSQL image variants).
EXTRAS_METAPACKAGE=postvec-extras

# --------------------------------------------------------------- publication
#
# These three reach every published package and image. `example` anywhere in
# them is treated as an unreplaced placeholder and refuses to build (override
# with POSTVEC_ALLOW_PLACEHOLDER_METADATA=1 for a throwaway local build).
IMAGE_REPOSITORY=ghcr.io/univec-ai/postvec
# Per-architecture images are pushed here first and combined into manifests in
# IMAGE_REPOSITORY only after each has passed a native test. Nothing a user
# could mistake for a release ever appears in the real repository.
IMAGE_STAGING_REPOSITORY=ghcr.io/univec-ai/postvec-staging
# The inference node's image lives in its own repository rather than under a
# tag of IMAGE_REPOSITORY: it has no PostgreSQL major, it carries a different
# licence, and a user pulls it onto a different kind of host. Its per-arch
# staging images share IMAGE_STAGING_REPOSITORY (tagged `run<id>-server-<arch>`).
# The versioned tag is `<RELEASE_ID>`; the moving tag is `latest` — the
# objection to `latest` on the PostgreSQL images (it hides the major, and a
# major change cannot upgrade a data directory) does not apply to a stateless
# node.
SERVER_IMAGE_REPOSITORY=ghcr.io/univec-ai/postvec-server
SOURCE_REPOSITORY=https://github.com/univec-ai/postvec
MAINTAINER="UniVec <support@univec.ai>"
VENDOR=UniVec

# ------------------------------------------------------------ postvec-server
#
# The node container that builds the dashboard (postvec-server/web-ui) into
# the postvec-server package. Pinned by digest like the nfpm and BuildKit
# images: it decides the bytes every node serves at /. The lockfile pins the
# npm dependencies themselves. Refresh with scripts/refresh-pins.sh.
# node 22.23.2 / npm 10.9.8 (node:22-bookworm-slim, resolved 2026-09-04).
NODE_IMAGE=docker.io/library/node:22-bookworm-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5
#
# The licence identifier the postvec-server package declares (SPDX). Every
# other package is PostgreSQL-licensed; this one is the exception, and the
# identifier is pinned here so that the crate manifest, the LICENSING.md index,
# the package metadata and the release gate (assert-versions.sh) are all held
# to one value. Changing the node's terms means changing this line together
# with postvec-server/Cargo.toml, postvec-server/LICENSE and the LICENSING.md
# index; the gate refuses a release where they disagree. Only Apache-2.0 is
# rendered as a reference to /usr/share/common-licenses on Debian — any other
# id inlines postvec-server/LICENSE into the package's copyright file.
SERVER_LICENSE=BUSL-1.1
