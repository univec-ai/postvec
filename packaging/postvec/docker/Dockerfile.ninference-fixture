# syntax=docker/dockerfile:1.7
#
# A real inference node, for testing the *remote* image against something that
# actually serves inference. The binary is `fixtures/inference-server` from
# this repository: the engine plus the gRPC handler bodies and error taxonomy
# lifted from postvec's embedded loopback server, compiled against the
# canonical proto/ contract.
#
# This is a test fixture, not a release artifact: it is never published, and
# nothing in it is part of the postvec release contract. It exists because the
# alternative — asserting only that the remote image degrades gracefully when
# no engine is reachable — leaves the entire remote path unexercised, which is
# how "the remote image works" becomes a claim nobody has checked.
#
# It serves the same engine and the same bundled model the embedded image runs
# in-process, so a passing remote test and a passing embedded test mean the
# same thing about the model.

ARG BUILD_BASE
ARG RUST_VERSION
ARG RUSTUP_VERSION
ARG RUSTUP_INIT_SHA256
ARG RUST_TRIPLE
ARG PROTOC_VERSION
ARG PROTOC_ARCH
ARG PROTOC_SHA256

FROM ${BUILD_BASE} AS builder

ARG RUST_VERSION
ARG RUSTUP_VERSION
ARG RUSTUP_INIT_SHA256
ARG RUST_TRIPLE
ARG PROTOC_VERSION
ARG PROTOC_ARCH
ARG PROTOC_SHA256

ENV DEBIAN_FRONTEND=noninteractive \
    CARGO_HOME=/usr/local/cargo \
    RUSTUP_HOME=/usr/local/rustup \
    CARGO_TERM_COLOR=never \
    PATH=/usr/local/cargo/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean && \
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential ca-certificates clang libclang-dev pkg-config \
        curl unzip git openssl libssl-dev

# The same pinned protoc and toolchain the release builders use, so the fixture
# is built from the same inputs as the thing it is testing against.
RUN set -eux; \
    curl --fail --silent --show-error --location --retry 3 -o /tmp/protoc.zip \
        "https://github.com/protocolbuffers/protobuf/releases/download/v${PROTOC_VERSION}/protoc-${PROTOC_VERSION}-${PROTOC_ARCH}.zip"; \
    echo "${PROTOC_SHA256}  /tmp/protoc.zip" | sha256sum --check --strict -; \
    mkdir -p /usr/local/protoc; \
    unzip -q -o /tmp/protoc.zip -d /usr/local/protoc; \
    ln -sf /usr/local/protoc/bin/protoc /usr/local/bin/protoc; \
    rm -f /tmp/protoc.zip

RUN set -eux; \
    curl --fail --silent --show-error --location --retry 3 -o /tmp/rustup-init \
        "https://static.rust-lang.org/rustup/archive/${RUSTUP_VERSION}/${RUST_TRIPLE}/rustup-init"; \
    echo "${RUSTUP_INIT_SHA256}  /tmp/rustup-init" | sha256sum --check --strict -; \
    chmod +x /tmp/rustup-init; \
    /tmp/rustup-init -y --no-modify-path --profile minimal \
        --default-toolchain "${RUST_VERSION}"; \
    rm -f /tmp/rustup-init

WORKDIR /src
COPY . .
RUN rm -rf /src/target /src/postvec/target

RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/src/target,sharing=locked,id=inference-fixture-target \
    set -eux; \
    cargo build --locked --release -p inference-fixture; \
    mkdir -p /out; \
    cp /src/target/release/inference-fixture /out/inference-fixture

# ---------------------------------------------------------------------- serve

FROM ${BUILD_BASE} AS fixture

ENV DEBIAN_FRONTEND=noninteractive \
    NINFERENCE_PATH=/ninference \
    RUST_LOG=info

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates openssl libgomp1 curl && \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /out/inference-fixture /usr/local/bin/inference-fixture

# The same ONNX Runtime and the same model bundle the embedded image carries,
# staged by the caller from the verified payloads.
COPY payload/ /ninference/

# A self-signed certificate: /config is served over HTTPS, and postvec's
# discovery accepts a self-signed one on a trusted network. Generated at build
# time because a fixture's private key must not exist anywhere but in the
# fixture.
RUN set -eux; \
    mkdir -p /ninference/certs; \
    openssl req -x509 -newkey rsa:2048 -nodes -days 3650 \
        -subj "/CN=ninference" \
        -addext "subjectAltName=DNS:ninference,DNS:localhost,IP:127.0.0.1" \
        -keyout /ninference/certs/ninference.key \
        -out /ninference/certs/ninference.crt; \
    chmod 0600 /ninference/certs/ninference.key

# The fixture is configured through its environment; the defaults below match
# what the smoke test dials (gRPC on 33333, HTTPS /config on 22222, assets and
# the self-signed certificate under /ninference).

EXPOSE 22222 33333
HEALTHCHECK --interval=5s --timeout=5s --start-period=180s --retries=24 \
    CMD curl --fail --silent --insecure https://127.0.0.1:22222/config >/dev/null || exit 1

CMD ["inference-fixture"]
