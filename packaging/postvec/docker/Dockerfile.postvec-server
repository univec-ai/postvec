# syntax=docker/dockerfile:1.7
#
# postvec-server image from this release's Debian 12 packages: the node,
# CLI, ONNX Runtime, bundled model and extras metapackage.
#
# Built through scripts/build-server-image.sh. Published as
# SERVER_IMAGE_REPOSITORY:<release id> and latest.
#
# The postvec-server binary is under SERVER_LICENSE, not the PostgreSQL
# License. See the image licenses label.

ARG BUILD_BASE
FROM ${BUILD_BASE}

ARG POSTVEC_VERSION
ARG RELEASE_ID
ARG SERVER_LICENSE
ARG IMAGE_SOURCE
ARG GIT_REVISION
ARG BUILD_DATE
ARG SOURCE_DATE_EPOCH

LABEL org.opencontainers.image.title="postvec-server" \
      org.opencontainers.image.description="Standalone inference node for postvec's remote mode: gRPC and HTTP embeddings and conversions, an OpenAI-compatible embeddings route, /config discovery and a dashboard." \
      org.opencontainers.image.version="${RELEASE_ID}" \
      org.opencontainers.image.licenses="${SERVER_LICENSE}" \
      org.opencontainers.image.source="${IMAGE_SOURCE}" \
      org.opencontainers.image.revision="${GIT_REVISION}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.vendor="UniVec"

# The engine root is the path the packages install to — and the one the
# postvec CLI treats as its default — so `--path` values are identical on a
# database host, in the local image, and here. POSTVEC_PATH and
# POSTVEC_PROVIDERS_PATH point the bundled CLI at the same root, so
# `docker exec <ctr> postvec model|provider …` needs no flags.
#
# POSTVEC_SERVER_CERTS_DIR is where the entrypoint generates (or expects) the
# TLS pair: the packaged /etc/postvec-server/config.json names
# /etc/postvec-server/server.{crt,key}, and the entrypoint and the
# configuration have to agree.
ENV DEBIAN_FRONTEND=noninteractive \
    POSTVEC_SERVER_ROOT=/opt/postvec \
    POSTVEC_SERVER_CERTS_DIR=/etc/postvec-server \
    POSTVEC_PATH=/opt/postvec \
    POSTVEC_PROVIDERS_PATH=/opt/postvec \
    RUST_LOG=info

# The packages, resolved by apt so their generated ELF dependencies (the
# OpenSSL runtime the TLS listener links, libgomp for ONNX Runtime) come from
# the distribution rather than from a hand-written list here. `openssl` is
# for the entrypoint's self-signed certificate, `curl` for the healthcheck.
# postvec-server's preinst creates the service account.
COPY dist/ /tmp/dist/
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    set -eux; \
    rm -f /etc/apt/apt.conf.d/docker-clean; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        ca-certificates openssl curl \
        /tmp/dist/*.deb; \
    rm -rf /tmp/dist; \
    test -x /usr/bin/postvec-server; \
    test -x /usr/bin/postvec; \
    test -d /opt/postvec/libs; \
    test -d /opt/postvec/models; \
    test -f /opt/postvec/server/ui/index.html; \
    getent passwd postvec-server >/dev/null

COPY postvec-server-entrypoint.sh /usr/local/bin/postvec-server-entrypoint

# Run unprivileged. The packages leave /opt/postvec and /etc/postvec-server
# root-owned, which is right for a host; in a container the service account
# owns both, so that the entrypoint can generate a per-container certificate
# beside the configuration and `docker exec <ctr> postvec model pull …` can
# add models without a second account. Mount your own pair over
# /etc/postvec-server/server.{crt,key} to skip generation.
# The serving-lease directory is what the unit's ExecStartPre creates
# on a host; the server FAILS TO START without it, deliberately. 1775
# root:postvec-server — group write for the lease, sticky so the service
# account cannot unlink locks it does not own. If your runtime mounts a fresh
# tmpfs over /run, recreate it exactly like this; if this container shares its
# engine root with the host (a bind-mounted /opt/postvec), bind-mount
# /run/lock/postvec too, so `postvec uninstall --purge` on the host and this
# node see the same lease inode.
RUN set -eux; \
    chown -R postvec-server:postvec-server /opt/postvec /etc/postvec-server; \
    chmod 0750 /etc/postvec-server; \
    install -d -m 1775 -o root -g postvec-server /run/lock/postvec
USER postvec-server

# 22222 discovery, HTTP inference and the dashboard (HTTPS), 33333 gRPC
# (plaintext), 11111 gossip. The admin port
# (22223) is deliberately NOT exposed: it is loopback-only and its routes
# mutate the engine.
EXPOSE 11111 22222 33333

# `/ready` rather than `/config`: it is 503 until a model can actually answer,
# so a container is only healthy once it can serve, not merely once it listens.
HEALTHCHECK --interval=5s --timeout=5s --start-period=180s --retries=24 \
    CMD curl --fail --silent --insecure https://127.0.0.1:22222/ready >/dev/null || exit 1

ENTRYPOINT ["postvec-server-entrypoint"]
CMD ["postvec-server"]
